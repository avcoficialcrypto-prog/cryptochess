# ============================================================
# CryptoChess Backend - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# Database (Supabase, Render Postgres, or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/cryptochess

# Authentication
JWT_SECRET=your-super-secret-random-key-min-32-chars

# ChangeNOW API (for USDC -> XMR sweep)
CHANGENOW_API_KEY=your-changenow-api-key

# Operator Monero wallet address (receives swept XMR)
OPERATOR_XMR_ADDRESS=your-monero-wallet-address

# Sweep threshold (default 50 USDC)
SWEEP_THRESHOLD_USDC=50

# Solana Pay (for stake deposits)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PLATFORM_WALLET_ADDRESS=your-platform-wallet-solana-address
