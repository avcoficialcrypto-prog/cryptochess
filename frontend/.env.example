# ============================================================
# CryptoChess Frontend - Environment Variables
# ============================================================

# Backend URL (use http://localhost:3001 for local dev)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Platform wallet address on Solana that receives USDC stakes
# Get this from your Phantom wallet or generate a new keypair
# This MUST be set for Solana Pay to work
NEXT_PUBLIC_PLATFORM_WALLET=

# Solana RPC endpoint (use a private RPC in production for speed)
# Free tier: https://api.mainnet-beta.solana.com (rate-limited)
# Recommended: Helius, QuickNode, or Alchemy
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
